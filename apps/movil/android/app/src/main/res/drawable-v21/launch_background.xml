<?xml version="1.0" encoding="utf-8"?>
<!-- Arranque con el color del marco de la app (#0E1730) y el ícono al centro,
     para que no aparezca un destello blanco antes de la primera pantalla. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#0E1730" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
