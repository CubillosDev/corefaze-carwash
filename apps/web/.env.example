# Copia este archivo como .env y ajusta los valores para tu máquina.
# El archivo .env NO se versiona: solo esta plantilla.
#
# Toda variable VITE_* termina dentro del JavaScript que descarga el navegador:
# es PÚBLICA. Nunca pongas aquí un secreto.

# URL base de la API (apps/api), incluido el prefijo /api.
VITE_API_URL=http://localhost:3000/api

# Llave del cliente web: viaja en el encabezado X-API-Key y cualquiera puede
# verla en el navegador. Identifica a la aplicación; no protege datos.
# En desarrollo local usa una de las llaves configuradas en TU apps/api/.env
# (generadas con crypto, ver apps/api/README.md). Nunca la compartas ni la subas.
# Pendiente en el backend: una API_KEY_WEB propia y JWT con roles en los recursos.
VITE_API_KEY=cambia-esto
