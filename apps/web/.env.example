# Copia este archivo como .env y ajusta los valores para tu máquina.
# El archivo .env NO se versiona: solo esta plantilla.
#
# Toda variable VITE_* termina dentro del JavaScript que descarga el navegador:
# es pública. Nunca pongas aquí un secreto.

# URL base de la API (apps/api), incluido el prefijo /api.
VITE_API_URL=http://localhost:3000/api

# Valor del encabezado X-API-Key. Es el mismo de API_KEY_ADMIN en apps/api/.env
# (el cliente "Panel administrativo"). Identifica a la aplicación, no protege
# datos: el control de acceso real es el inicio de sesión.
VITE_API_KEY=REEMPLAZAR_CON_LA_API_KEY_ADMIN_DE_LA_API
