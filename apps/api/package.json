{
  "name": "@carwash/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST del sistema Car Wash (Node.js + Express)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:cobertura": "jest --coverage --passWithNoTests"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/api"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/data/**"
    ],
    "clearMocks": true,
    "testMatch": [
      "**/apps/api/tests/**/*.test.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "../../packages"
    ],
    "rootDir": "../.."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  }
}
