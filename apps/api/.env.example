NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Una llave por cliente: cada una identifica quién consume la API
# y se puede revocar (rotando su valor) sin afectar a las demás.
API_KEY_POSTMAN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_ADMIN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_MOVIL=REEMPLAZAR_CON_API_KEY_SEGURA
# Llave propia del panel web (apps/web, variable VITE_API_KEY). Antes el
# panel usaba API_KEY_ADMIN; tenerla aparte permite revocarla sin afectar
# a Postman ni al móvil. Identifica a la aplicación, no protege los datos
# (la protección real es JWT + RBAC, ver SCRUM-139).
API_KEY_WEB=REEMPLAZAR_CON_API_KEY_SEGURA
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h

# URL del proyecto Supabase real (SCRUM-152). No es secreta, pero no se
# versiona la URL real del proyecto en este archivo de ejemplo. Para
# desarrollo local contra el stack de `npx supabase start`, usa la URL
# que imprime la CLI (normalmente http://127.0.0.1:54321), nunca esta.
SUPABASE_URL=REEMPLAZAR_CON_URL_DEL_PROYECTO
# SÍ es secreta: bypasea RLS por completo. Pide el valor real a Diego;
# nunca lo escribas aquí ni en ningún archivo versionado. Para pruebas
# y desarrollo local usa la service_role key que imprime
# `npx supabase start` (es fija y conocida para cualquier instalación
# local de la CLI, no es un secreto real).
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY_REAL

# Opcionales EN CONJUNTO: si las tres están ausentes, no hay bootstrap (la
# API arranca igual). Pero si se define cualquiera de las tres, email y
# password se validan igual que una API Key (obligatorias, sin el valor de
# ejemplo, password de al menos 12 caracteres) — el script se niega a
# arrancar en vez de crear un superadmin con esta contraseña de ejemplo.
# El superadmin NO se crea al levantar el servidor: se crea ejecutando
# `npm run seed:superadmin` (src/scripts/crearSuperAdmin.js) por separado.
# Es la ÚNICA forma de arrancar RBAC sin hardcodear una cuenta: el registro
# público siempre nace "pendiente", y asignar un rol
# (PATCH /api/auth/usuarios/:id/rol) ya requiere ser superadmin. No se usan
# en los tests (crearApp nunca llama este bootstrap).
SUPERADMIN_NOMBRE=Super Administrador
SUPERADMIN_EMAIL=superadmin@lavadero.com
SUPERADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA