NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Una llave por cliente: cada una identifica quién consume la API
# y se puede revocar sin afectar a las demás.
API_KEY_POSTMAN=a8ebdf63b8026d9979fa8236530182cd2823a7879f02347cf1ef379db9519de
API_KEY_ADMIN=4e6b4cf512aecf844b0c67b3533ee6523cb9a8a905d8d0c814d4eb159854aa3
API_KEY_MOVIL=a94cdcc2b6fd135e8db5912c6351b1f533271d0181c0c9e0be51ff82a6ff2883
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h

# Opcionales EN CONJUNTO: si las tres están ausentes, no hay bootstrap (la
# API arranca igual). Pero si se define cualquiera de las tres, email y
# password se validan igual que una API Key (obligatorias, sin el valor de
# ejemplo, password de al menos 12 caracteres) — la API se niega a
# arrancar en vez de crear un superadmin con esta contraseña de ejemplo.
# Es la ÚNICA forma de arrancar RBAC sin hardcodear una cuenta: el registro
# público siempre nace "pendiente", y asignar un rol
# (PATCH /api/auth/usuarios/:id/rol) ya requiere ser superadmin. No se usan
# en los tests (crearApp nunca llama este bootstrap).
SUPERADMIN_NOMBRE=Super Administrador
SUPERADMIN_EMAIL=superadmin@lavadero.com
SUPERADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA