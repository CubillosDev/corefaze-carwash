# Entorno: development | test | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=3000

# Llave que deben enviar web y móvil en el header X-API-Key.
# Genera una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=cambiar-por-una-llave-larga-y-aleatoria

# Origen permitido por CORS (el panel web con Vite)
ALLOWED_ORIGIN=http://localhost:5173