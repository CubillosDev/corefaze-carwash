NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Una llave por cliente: cada una identifica quién consume la API
# y se puede revocar (rotando su valor) sin afectar a las demás.
API_KEY_POSTMAN=a8ebdf63b8026d9979fa8236530182cd2823a7879f02347cf1ef379db9519de
API_KEY_ADMIN=4e6b4cf512aecf844b0c67b3533ee6523cb9a8a905d8d0c814d4eb159854aa3
API_KEY_MOVIL=a94cdcc2b6fd135e8db5912c6351b1f533271d0181c0c9e0be51ff82a6ff2883
# Llave propia del panel web (apps/web, variable VITE_API_KEY). Antes el
# panel usaba API_KEY_ADMIN; tenerla aparte permite revocarla sin afectar
# a Postman ni al móvil. Identifica a la aplicación, no protege los datos
# (la protección real es JWT + RBAC, ver SCRUM-139).
API_KEY_WEB=7c1f9e5b6a3d2c8f4e0b1a9d6c5f8e3b2a7d4c9f1e6b8a3d5c2f9e4b7a1d6c8f
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h