{
  "name": "corefaze-carwash",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo del proyecto integrador Car Wash",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
